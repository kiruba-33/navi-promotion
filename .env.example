# ─────────────────────────────────────────────────────────────
# EmailJS — Careers "Apply Now" form
# Copy this file to .env and fill in your real values.
# .env is git-ignored; this file IS committed as documentation.
# ─────────────────────────────────────────────────────────────
# Get these values from https://dashboard.emailjs.com
#   Account → Email Services  → your_service_id
#   Account → Email Templates → your_template_id
#   Account → API Keys        → your_public_key

VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=
